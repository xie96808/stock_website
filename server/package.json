{
  "name": "stock-website-server",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "migrate": "node src/db/migrate.js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/**/*.test.js",
    "admin:promote": "node scripts/admin-promote.mjs",
