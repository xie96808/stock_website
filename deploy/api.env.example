# Copy to /etc/stockgame/api.env (mode 0640, owner root:stockapi). Do not commit real secrets.

PORT=8787
NODE_ENV=production

# Required in production (>=16 chars). Generate e.g.: openssl rand -hex 32
CSRF_SECRET=replace-with-long-random-secret

# Comma-separated browser Origins allowed for credentialed writes
ORIGIN_ALLOWLIST=https://stockgame.xieyw.top

# Force Secure cookies (also implied when NODE_ENV=production)
COOKIE_SECURE=1

# Production default cookie name is __Host-stockgame_session (Secure + Path=/ + no Domain).
# Only override if you know why; __Host- requires COOKIE_SECURE=1 and HTTPS.
# SESSION_COOKIE_NAME=__Host-stockgame_session

# SQLite + writable state (separate from release tree)
STOCKGAME_DATA_DIR=/var/lib/stockgame
# Optional explicit DB path (defaults to $STOCKGAME_DATA_DIR/stockgame.sqlite)
# STOCKGAME_DB_PATH=/var/lib/stockgame/stockgame.sqlite

# Dataset: static release pack or a copy under /var/lib/stockgame
STOCKGAME_DATASET_PATH=/srv/stock-website/current/data/stocks_data.json

# Behind nginx: Express should not also serve the static site
STATIC_ROOT=
SKIP_STATIC=1

# Session lifetimes (Phase 0): idle sliding + absolute from login/create.
# Defaults: idle 7d, absolute 7d (cookie maxAge = absolute). Idle cannot extend past absolute.
# SESSION_IDLE_DAYS=7
# SESSION_ABSOLUTE_DAYS=7

# Phase 0 rate limits (in-memory; see README-ops-stage6.md §8)
# RATE_LOGIN_FAIL_PER_ACCOUNT_IP=5
# RATE_LOGIN_FAIL_PER_IP=30
# RATE_LOGIN_FAIL_WINDOW_MS=900000
# RATE_REGISTER_PER_IP_HOUR=5
# RATE_REGISTER_PER_IP_DAY=20
# RATE_CREATE_GAME_PER_USER_MINUTE=10
# RATE_CREATE_GAME_PER_USER_DAY=100

# Stage 5 minimal admin (default off — do not expose on public internet)
# Enable only behind nginx IP allowlist / VPN, then:
# ADMIN_ENABLED=1
# Optional IP allowlist for /api/v1/admin/* (comma-separated). Empty = no app-level IP filter.
# ADMIN_IP_ALLOWLIST=203.0.113.10
# Optional non-default static admin path segment (default: admin → /admin/)
# ADMIN_UI_PATH=admin

# Stage 6 ops switches (default ON). Set to 0 to disable; changes need ops audit.
# REGISTRATION_ENABLED=1
# CLOUD_GAMES_ENABLED=1
# LEADERBOARD_ENABLED=1

# Backup locations (recommended on VPS)
# STOCKGAME_BACKUP_DIR=/var/backups/stockgame
# STOCKGAME_BACKUP_STATUS_PATH=/var/lib/stockgame/backup-status.json
